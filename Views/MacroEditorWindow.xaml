<Window x:Class="RTS_Tactical_Overlay.Views.MacroEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Macro Editor"
        Width="400" Height="450"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E1E"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFCCCCCC"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF2D2D2D"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="#FF3F3F3F"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FF2D2D2D"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFCCCCCC"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF3F3F3F"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="#FF5F5F5F"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Macro Name -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Macro Name" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="MacroNameTextBox" Text="{Binding MacroName, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <!-- Add Action Panel -->
        <Border Grid.Row="1" Background="#FF252525" CornerRadius="4" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Action Type -->
                <ComboBox x:Name="ActionTypeCombo" Grid.Column="0" Grid.Row="0" Width="90" Margin="0,0,8,0"
                          SelectedIndex="0" SelectionChanged="ActionTypeCombo_SelectionChanged">
                    <ComboBoxItem Content="KeyPress"/>
                    <ComboBoxItem Content="KeyDown"/>
                    <ComboBoxItem Content="KeyUp"/>
                    <ComboBoxItem Content="Delay"/>
                </ComboBox>

                <!-- Key Input -->
                <TextBox x:Name="KeyInputTextBox" Grid.Column="1" Grid.Row="0"
                         MaxLength="10" Margin="0,0,8,0"/>

                <!-- Add/Cancel Buttons -->
                <StackPanel Grid.Column="2" Grid.Row="0" Orientation="Horizontal">
                    <Button x:Name="AddActionButton" Content="Add" Click="AddAction_Click" Width="50"/>
                    <Button x:Name="CancelEditButton" Content="X" Click="CancelEdit_Click" Width="24"
                            Margin="4,0,0,0" Visibility="Collapsed" Foreground="#FFFF6666"
                            ToolTip="Cancel editing"/>
                </StackPanel>

                <!-- Modifiers -->
                <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <CheckBox x:Name="CtrlCheckBox" Content="Ctrl" Margin="0,0,12,0"/>
                    <CheckBox x:Name="ShiftCheckBox" Content="Shift" Margin="0,0,12,0"/>
                    <CheckBox x:Name="AltCheckBox" Content="Alt" Margin="0,0,12,0"/>
                    <TextBlock Text="Delay:" VerticalAlignment="Center" Margin="8,0,4,0"/>
                    <TextBox x:Name="DelayTextBox" Text="50" Width="50"/>
                    <TextBlock Text="ms" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Actions List -->
        <Border Grid.Row="2" Background="#FF252525" CornerRadius="4" Padding="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ListBox x:Name="ActionsListBox" Grid.Column="0"
                         Background="Transparent" BorderThickness="0"
                         Foreground="#FFFFFFFF"
                         SelectionMode="Single"
                         MouseDoubleClick="ActionsListBox_MouseDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="#FFFFFFFF"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                    <Setter Property="Background" Value="#FF3A5F3A"/>
                                    <Setter Property="Foreground" Value="#FF88FF88"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayText}" Padding="4,2"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0">
                    <Button Content="Edit" Click="Edit_Click" Width="40" Margin="0,2"
                            Foreground="#FF00D9FF"/>
                    <Button Content="Up" Click="MoveUp_Click" Width="40" Margin="0,2"/>
                    <Button Content="Down" Click="MoveDown_Click" Width="40" Margin="0,2"/>
                    <Button Content="Del" Click="Delete_Click" Width="40" Margin="0,2"
                            Foreground="#FFFF6666"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Preview -->
        <Border Grid.Row="3" Background="#FF202020" CornerRadius="4" Padding="8" Margin="0,8,0,0">
            <StackPanel>
                <TextBlock Text="Preview" FontWeight="SemiBold" Foreground="#FF888888" Margin="0,0,0,4"/>
                <TextBlock x:Name="PreviewText" Text="" Foreground="#FF00D9FF" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Dialog Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="RecordButton" Content="Record" Click="Record_Click" Margin="0,0,8,0"
                    Background="#FF882222" Foreground="#FFFFFFFF"/>
            <Button Content="Clear" Click="ClearMacro_Click" Margin="0,0,8,0"
                    Foreground="#FFFFAA00"/>
            <Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0"/>
            <Button Content="OK" Click="OK_Click" Width="60" Background="#FF00AA66"/>
        </StackPanel>
    </Grid>
</Window>
