<Window x:Class="RTS_Tactical_Overlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:RTS_Tactical_Overlay.Converters"
        mc:Ignorable="d"
        Title="RTS Tactical Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Left="0"
        Top="0"
        Width="{Binding Source={x:Static SystemParameters.PrimaryScreenWidth}}"
        Height="70"
        d:DesignHeight="70" d:DesignWidth="800">

    <Window.Resources>
        <!-- Converters -->
        <converters:ProgressToGradientConverter x:Key="ProgressToGradientConverter"/>
        <converters:NodeProgressToColorConverter x:Key="NodeProgressToColorConverter"/>
        <converters:NodeColorProgressConverter x:Key="NodeColorProgressConverter"/>
        <converters:LineColorProgressConverter x:Key="LineColorProgressConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- Converter for ExecutionState to visual properties -->
        <Style x:Key="TimelineCircleStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Style.Triggers>
                <!-- Pending: Hollow circle with dim border -->
                <DataTrigger Binding="{Binding ExecutionState}" Value="Pending">
                    <Setter Property="Fill" Value="Transparent"/>
                    <Setter Property="Stroke" Value="#40FFFFFF"/>
                </DataTrigger>

                <!-- Executed: Filled circle with bright cyan -->
                <DataTrigger Binding="{Binding ExecutionState}" Value="Executed">
                    <Setter Property="Fill" Value="#FF00D9FF"/>
                    <Setter Property="Stroke" Value="#FF00D9FF"/>
                </DataTrigger>

                <!-- Active: Filled circle with pulsing glow effect -->
                <DataTrigger Binding="{Binding ExecutionState}" Value="Active">
                    <Setter Property="Fill" Value="#FF00FF88"/>
                    <Setter Property="Stroke" Value="#FF00FF88"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#00FF88" BlurRadius="15" ShadowDepth="0" Opacity="0.8"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Style for neon connecting lines -->
        <Style x:Key="NeonLineStyle" TargetType="Line">
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="Y1" Value="12"/>
            <Setter Property="Y2" Value="12"/>
            <Style.Triggers>
                <!-- Dim line for pending connections -->
                <DataTrigger Binding="{Binding IncomingLineProgress}" Value="0">
                    <Setter Property="Stroke" Value="#20FFFFFF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Style for unit key text -->
        <Style x:Key="UnitKeyTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ExecutionState}" Value="Pending">
                    <Setter Property="Foreground" Value="#80FFFFFF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Overlay Bar - Top Center (responsive width: 80% of screen, max 1200px) -->
        <Border x:Name="OverlayBar"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                MinWidth="800"
                MaxWidth="1200"
                Height="60"
                Background="#80000000"
                CornerRadius="0,0,8,8"
                Margin="0,0,0,0">

            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Status Indicator and Profile Selector -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,15,0">
                    <!-- Status Indicator Light -->
                    <Ellipse x:Name="StatusIndicator" Width="12" Height="12" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <!-- Default: Ready (Gray) -->
                                <Setter Property="Fill" Value="#FF666666"/>
                                <Style.Triggers>
                                    <!-- Executing: Green with glow -->
                                    <DataTrigger Binding="{Binding IsExecuting}" Value="True">
                                        <Setter Property="Fill" Value="#FF00FF88"/>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#00FF88" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                    <!-- Paused: Yellow -->
                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                        <Setter Property="Fill" Value="#FFFFAA00"/>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#FFAA00" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <!-- Profile Selector (clickable) -->
                    <Border x:Name="ProfileSelector"
                            Background="#40000000"
                            CornerRadius="3"
                            Margin="8,0,0,0"
                            Padding="6,2"
                            Cursor="Hand"
                            MouseLeftButtonDown="ProfileSelector_MouseLeftButtonDown"
                            MouseWheel="ProfileSelector_MouseWheel">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding CurrentProfileAlias}"
                                       Foreground="#FF00D9FF"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="▼"
                                       Foreground="#80FFFFFF"
                                       FontSize="8"
                                       VerticalAlignment="Center"
                                       Margin="4,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Profile Dropdown Popup -->
                    <Popup x:Name="ProfilePopup"
                           PlacementTarget="{Binding ElementName=ProfileSelector}"
                           Placement="Bottom"
                           StaysOpen="False"
                           IsOpen="{Binding IsProfileMenuOpen, Mode=TwoWay}"
                           AllowsTransparency="True">
                        <Border Background="#F0202020"
                                CornerRadius="4"
                                BorderBrush="#40FFFFFF"
                                BorderThickness="1"
                                Padding="4">
                            <StackPanel>
                                <!-- Profile List -->
                                <ItemsControl ItemsSource="{Binding AvailableProfiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent"
                                                    Padding="8,4"
                                                    Cursor="Hand"
                                                    MouseLeftButtonDown="ProfileItem_MouseLeftButtonDown">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#40FFFFFF"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Alias}"
                                                                   Foreground="#FF00D9FF"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   Width="45"/>
                                                        <TextBlock Text="{Binding Name}"
                                                                   Foreground="#FFCCCCCC"
                                                                   FontSize="10"
                                                                   MaxWidth="100"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1"
                                                               Text="✕"
                                                               Foreground="#80FF6666"
                                                               FontSize="10"
                                                               VerticalAlignment="Center"
                                                               Margin="8,0,0,0"
                                                               Cursor="Hand"
                                                               MouseLeftButtonDown="DeleteProfile_MouseLeftButtonDown">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Foreground" Value="#FFFF6666"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Separator -->
                                <Rectangle Height="1" Fill="#40FFFFFF" Margin="4,4"/>

                                <!-- New Profile Button -->
                                <Border Background="Transparent"
                                        Padding="8,4"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="NewProfile_MouseLeftButtonDown">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#40FFFFFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="+ New Profile"
                                               Foreground="#FF00FF88"
                                               FontSize="10"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>

                <!-- Timeline Visualization -->
                <ScrollViewer Grid.Column="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              VerticalAlignment="Center"
                              Margin="0,0,0,0">
                    <Canvas Height="50" Width="{Binding TimelineWidth}"
                            Background="Transparent"
                            MouseLeftButtonDown="Timeline_MouseLeftButtonDown">
                        <!-- Layer 1: All connecting lines (drawn first, at bottom) -->
                        <ItemsControl ItemsSource="{Binding TimelineNodes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas Height="50"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Neon connecting line from this node to next -->
                                    <Line X1="0"
                                          Y1="25"
                                          X2="{Binding Width}"
                                          Y2="25"
                                          StrokeThickness="2"
                                          ToolTip="{Binding TooltipText}">
                                        <Line.Stroke>
                                            <MultiBinding Converter="{StaticResource LineColorProgressConverter}">
                                                <Binding Path="IncomingLineProgress"/>
                                                <Binding Path="NodeColor"/>
                                            </MultiBinding>
                                        </Line.Stroke>
                                        <Line.Style>
                                            <Style TargetType="Line">
                                                <Style.Triggers>
                                                    <!-- Add glow effect when fully lit -->
                                                    <DataTrigger Binding="{Binding IncomingLineProgress}" Value="1">
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.6">
                                                                    <DropShadowEffect.Color>
                                                                        <Binding Path="NodeColor"/>
                                                                    </DropShadowEffect.Color>
                                                                </DropShadowEffect>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Line.Style>
                                    </Line>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemContainerStyle>
                                <Style>
                                    <Setter Property="Canvas.Left" Value="{Binding XPosition}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>

                        <!-- Layer 2: All circle nodes (drawn second, on top) -->
                        <ItemsControl ItemsSource="{Binding TimelineNodes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas Height="50"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Circle node with background to cover line -->
                                    <Grid Width="28" Height="28"
                                          ToolTip="{Binding TooltipText}"
                                          Tag="{Binding StageIndex}"
                                          MouseLeftButtonDown="Node_MouseLeftButtonDown"
                                          MouseMove="Node_MouseMove"
                                          MouseLeftButtonUp="Node_MouseLeftButtonUp"
                                          MouseRightButtonDown="Node_MouseRightButtonDown"
                                          Cursor="SizeWE">
                                        <!-- Context Menu -->
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Delete Node"
                                                          Click="DeleteNode_Click"/>
                                                <MenuItem Header="Toggle Enable"
                                                          Click="ToggleNodeEnabled_Click"/>
                                            </ContextMenu>
                                        </Grid.ContextMenu>

                                        <!-- Background circle -->
                                        <Ellipse Width="28" Height="28" Fill="#FF1A1A1A"/>

                                        <!-- Main circle with progress-based color -->
                                        <Ellipse Width="24" Height="24"
                                                 StrokeThickness="2"
                                                 Fill="Transparent">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Opacity" Value="1.0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                            <Setter Property="Opacity" Value="0.4"/>
                                                            <Setter Property="StrokeDashArray" Value="2,2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                            <Ellipse.Stroke>
                                                <MultiBinding Converter="{StaticResource NodeColorProgressConverter}">
                                                    <Binding Path="NodeProgress"/>
                                                    <Binding Path="NodeColor"/>
                                                </MultiBinding>
                                            </Ellipse.Stroke>
                                        </Ellipse>

                                        <TextBlock Text="{Binding DisplayText}"
                                                   Style="{StaticResource UnitKeyTextStyle}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemContainerStyle>
                                <Style>
                                    <Setter Property="Canvas.Left" Value="{Binding XPosition}"/>
                                    <Setter Property="Canvas.Top" Value="13"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>

                        <!-- Layer 3: Drag duration tooltip (centered on midpoint) -->
                        <Canvas Canvas.Left="{Binding DragTooltipX}" Canvas.Top="-2"
                                Visibility="{Binding IsDraggingNode, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border Canvas.Left="-22"
                                    Background="#E0000000"
                                    CornerRadius="3"
                                    Padding="6,2">
                                <TextBlock Text="{Binding DragDurationText}"
                                           Foreground="#FF00D9FF"
                                           FontSize="11"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </Canvas>
                    </Canvas>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
